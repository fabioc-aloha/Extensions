{
  "name": "svg-toolkit",
  "displayName": "CX SVG Toolkit",
  "description": "Live-preview, inspect colors, copy, template, and validate SVG files with focused local utilities",
  "version": "0.2.0",
  "publisher": "fabioc-aloha",
  "author": "Fabio Correa",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "svg",
    "icons",
    "preview",
    "graphics",
    "data uri",
    "base64",
    "svg preview",
    "vector graphics",
    "icon templates"
  ],
  "activationEvents": [
    "onLanguage:svg"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "svgToolkit.preview",
        "title": "SVG Toolkit: Preview SVG"
      },
      {
        "command": "svgToolkit.copyDataUri",
        "title": "SVG Toolkit: Copy as Data URI"
      },
      {
        "command": "svgToolkit.copyMarkdown",
        "title": "SVG Toolkit: Copy as Markdown Image"
      },
      {
        "command": "svgToolkit.insertIconTemplate",
        "title": "SVG Toolkit: Insert Icon Template"
      },
      {
        "command": "svgToolkit.validateSvg",
        "title": "SVG Toolkit: Validate SVG"
      },
      {
        "command": "svgToolkit.extractColors",
        "title": "SVG Toolkit: Extract SVG Colors"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "cx.tools",
          "group": "navigation@99"
        }
      ],
      "explorer/context": [
        {
          "submenu": "cx.tools",
          "group": "navigation@99"
        }
      ],
      "cx.tools": [
        {
          "command": "svgToolkit.preview",
          "when": "resourceExtname == .svg",
          "group": "1_analysis@1"
        },
        {
          "command": "svgToolkit.copyDataUri",
          "when": "resourceExtname == .svg",
          "group": "2_transform@1"
        },
        {
          "command": "svgToolkit.copyMarkdown",
          "when": "resourceExtname == .svg",
          "group": "2_transform@2"
        },
        {
          "command": "svgToolkit.insertIconTemplate",
          "when": "resourceExtname == .svg",
          "group": "3_generate@1"
        },
        {
          "command": "svgToolkit.validateSvg",
          "when": "resourceExtname == .svg",
          "group": "1_analysis@2"
        },
        {
          "command": "svgToolkit.extractColors",
          "when": "resourceExtname == .svg",
          "group": "1_analysis@3"
        }
      ]
    },
    "submenus": [
      {
        "id": "cx.tools",
        "label": "$(tools) CX Tools"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabioc-aloha/Extensions"
  },
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  }
}
