{
  "name": "hook-studio",
  "displayName": "CX Hook Studio",
  "description": "Validate and inspect VS Code Copilot hook configuration files, including the current multi-file hooks layout",
  "version": "0.2.0",
  "publisher": "fabioc-aloha",
  "author": "Fabio Correa",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "hooks",
    "agent",
    "copilot",
    "automation",
    "hooks.json",
    "vscode agent",
    "copilot hooks",
    "agent hooks",
    "workflow automation",
    "tool hooks",
    "agent customization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fabioc-aloha/Extensions"
  },
  "activationEvents": [
    "onCommand:hookStudio.open",
    "onCommand:hookStudio.testCondition",
    "onCommand:hookStudio.importFromAlex",
    "onCommand:hookStudio.exportHooks",
    "onCommand:hookStudio.openLog",
    "onCommand:hookStudio.validateWorkspaceHooks",
    "workspaceContains:.github/hooks/*.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hookStudio.open",
        "title": "Hook Studio: Open GUI",
        "icon": "$(symbol-event)"
      },
      {
        "command": "hookStudio.testCondition",
        "title": "Hook Studio: Test Hook Condition"
      },
      {
        "command": "hookStudio.importFromAlex",
        "title": "Hook Studio: Import hooks.json from Alex"
      },
      {
        "command": "hookStudio.exportHooks",
        "title": "Hook Studio: Export hooks.json"
      },
      {
        "command": "hookStudio.openLog",
        "title": "Hook Studio: Open Execution Log"
      },
      {
        "command": "hookStudio.validateWorkspaceHooks",
        "title": "Hook Studio: Validate Workspace Hooks"
      },
      {
        "command": "hookStudio.migrateLegacyHooks",
        "title": "Hook Studio: Migrate Legacy hooks.json"
      },
      {
        "command": "hookStudio.createRecipe",
        "title": "Hook Studio: Create Hook Recipe"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "cx.tools",
          "group": "navigation@99"
        }
      ],
      "explorer/context": [
        {
          "submenu": "cx.tools",
          "group": "navigation@99"
        }
      ],
      "cx.tools": [
        {
          "command": "hookStudio.open",
          "when": "resourceFilename == hooks.json",
          "group": "1_analysis@1"
        },
        {
          "command": "hookStudio.testCondition",
          "when": "resourceFilename == hooks.json",
          "group": "1_analysis@2"
        },
        {
          "command": "hookStudio.exportHooks",
          "when": "resourceFilename == hooks.json",
          "group": "2_transform@1"
        },
        {
          "command": "hookStudio.openLog",
          "when": "resourceFilename == hooks.json",
          "group": "1_analysis@3"
        },
        {
          "command": "hookStudio.validateWorkspaceHooks",
          "when": "resourceFilename == hooks.json",
          "group": "1_analysis@4"
        },
        {
          "command": "hookStudio.migrateLegacyHooks",
          "when": "resourceFilename == hooks.json",
          "group": "2_transform@2"
        },
        {
          "command": "hookStudio.createRecipe",
          "group": "3_generate@1"
        }
      ]
    },
    "submenus": [
      {
        "id": "cx.tools",
        "label": "$(tools) CX Tools"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json --noEmit",
    "bundle": "npx esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --target=node20 --format=cjs --minify",
    "watch": "npx esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --target=node20 --format=cjs --watch",
    "package": "npm run bundle && npx @vscode/vsce package",
    "publish": "npm run bundle && npx @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.109.0",
    "typescript": "^5.7.0",
    "@vscode/vsce": "^3.0.0"
  },
  "license": "MIT",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  }
}
