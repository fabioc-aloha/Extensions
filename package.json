{
    "name": "alex-extensions",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Alex Cognitive Architecture — Standalone VS Code Extensions Monorepo",
    "workspaces": [
        "shared",
        "extensions/*"
    ],
    "scripts": {
        "compile:all": "npm run compile --workspaces --if-present",
        "lint:all": "npm run lint --workspaces --if-present",
        "test:all": "npm run test --workspaces --if-present",
        "package:all": "node scripts/package-all.js",
        "publish:all": "node scripts/package-all.js --publish",
        "publish:all:entra": "node scripts/package-all.js --publish --azure-credential",
        "clean:all": "node scripts/clean-all.js"
    },
    "devDependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.109.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.2",
        "eslint": "^9.0.0",
        "image-size": "^2.0.2",
        "typescript": "^5.7.0"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "overrides": {
        "pptxgenjs": {
            "image-size": "2.0.2"
        }
    },
    "author": {
        "name": "Fabio Correa",
        "email": "fabioc@aloha.ms"
    },
    "license": "MIT"
}
